{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tetorica Playground",
  "version": "0.85.1",
  "identifier": "net.tetorica.ym2612-playground",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": {
      "script": "node scripts/prepare_audio_sidecar.mjs",
      "wait": true
    },
    "beforeBuildCommand": "node scripts/prepare_audio_sidecar.mjs"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Tetorica Playground",
        "width": 1280,
        "height": 820,
        "dragDropEnabled": false,
        "create": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Music",
    "macOS": {
      "infoPlist": "Info.plist",
      "entitlements": "Microphone.entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../audio-sidecar-bundle/": "audio-sidecar/",
      "native-livefx/quickjs-ng/LICENSE": "quickjs-ng-LICENSE.txt",
      "native-megacd/LICENSE": "rf5c164-LICENSE.txt",
      "native-dx7/COPYING": "msfa-dx7-LICENSE.txt",
      "native-nes/LICENSE-JSNES": "jsnes-LICENSE.txt",
      "native-nes/LICENSE-FDS": "fixnes-fds-LICENSE.txt",
      "native-nes/snapshot/third_party/jsnes/AUTHORS.md": "jsnes-AUTHORS.md",
      "../desktop/git-licenses.txt": "git-licenses.txt",
      "../desktop/git-js-licenses.txt": "git-js-licenses.txt",
      "native-gameboy/LICENSE": "gameboy-LICENSE.txt",
      "native-huc6280/LICENSE": "huc6280-LICENSE.txt",
      "native-snes/LICENSE": "snes-spc-COPYING.txt",
      "native-snes/README.md": "snes-spc-native-README.md",
      "native-snes/": "native-snes/",
      "native-pwm/LICENSE": "pwm32x-LICENSE.txt"
    }
  }
}

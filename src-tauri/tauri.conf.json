{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tetorica Playground",
  "version": "0.52.6",
  "identifier": "net.tetorica.ym2612-playground",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node scripts/prepare_audio_sidecar.mjs",
    "beforeBuildCommand": "node scripts/prepare_audio_sidecar.mjs"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Tetorica Playground",
        "width": 1280,
        "height": 820,
        "dragDropEnabled": false,
        "create": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Music",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../audio-sidecar-bundle/": "audio-sidecar/"
    }
  }
}
